# Copy this file to application-local.properties and add your own SMTP credentials.
# This local file is ignored by Git. For Gmail, use an App Password.
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=your-email@gmail.com
spring.mail.password=your-gmail-app-password
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
app.mail.from=your-email@gmail.com

# Gemini API key (create one at https://aistudio.google.com/app/apikey)
spring.ai.google.genai.api-key=YOUR_GEMINI_API_KEY
spring.ai.google.genai.embedding.api-key=YOUR_GEMINI_API_KEY
# Recipe RAG embedding configuration (shared Gemini API key above)
spring.ai.google.genai.embedding.text.model=gemini-embedding-001
spring.ai.google.genai.embedding.text.dimensions=768
spring.ai.google.genai.embedding.text.auto-truncate=false
